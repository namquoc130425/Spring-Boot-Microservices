        └── compare-core/
            └── pom.xml          <- file này
    -->
	<parent>

		<groupId>com.nvqn</groupId>

		<artifactId>nvqn-common-parent</artifactId>

		<version>1.0.0-SNAPSHOT</version>

		<!-- Parent nằm phía trên 1 thư mục -->
		<relativePath>../pom.xml</relativePath>

	</parent>


